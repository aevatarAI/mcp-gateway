{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ContainerRegistrySettings": {
    "Endpoint": "",
    "Username": "",
    "Password": "",
    "ImagePullPolicy": "Always",
    "DefaultTag": "latest"
  },
  "KubernetesSettings": {
    "Namespace": "adapter",
    "LabelPrefix": "adapter",
    "SecurityContext": {
      "RunAsUser": 1100,
      "RunAsGroup": 1100,
      "AllowPrivilegeEscalation": false,
      "ReadOnlyRootFilesystem": true,
      "DropCapabilities": ["ALL"]
    },
    "ServiceAccountName": "workload-sa",
    "Resources": {
      "Limits": {
        "Cpu": "1",
        "Memory": "512Mi",
        "EphemeralStorage": "2Gi"
      },
      "Requests": {
        "Cpu": "250m",
        "Memory": "256Mi"
      }
    }
  },
  "ServiceSettings": {
    "Port": 8000,
    "AdapterPort": 8000,
    "Protocol": "TCP"
  },
  "PublicOrigin":  "http://localhost:8000/"
}
